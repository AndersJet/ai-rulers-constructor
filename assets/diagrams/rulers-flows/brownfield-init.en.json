{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Brownfield · From evidence to active rules",
    "locale": "en",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "prepare",
      "label": "Discovery & setup"
    },
    {
      "id": "review",
      "label": "Review & activation"
    },
    {
      "id": "hold",
      "label": "Needs revision",
      "variant": "exception"
    }
  ],
  "nodes": [
    {
      "id": "facts",
      "lane": "prepare",
      "col": 0,
      "type": "external",
      "label": "Inspect project",
      "sublabel": "observed · code / tests",
      "width": 148
    },
    {
      "id": "plan",
      "lane": "prepare",
      "col": 1,
      "type": "backend",
      "label": "Review plan",
      "sublabel": "plan → review → apply",
      "width": 148
    },
    {
      "id": "draft",
      "lane": "prepare",
      "col": 2,
      "type": "database",
      "label": "Create profile",
      "sublabel": "Draft · Level 0",
      "width": 148
    },
    {
      "id": "profile-gate",
      "lane": "review",
      "col": 2,
      "type": "security",
      "label": "Profile ready?",
      "sublabel": "review-profile",
      "width": 148
    },
    {
      "id": "candidate",
      "lane": "review",
      "col": 3,
      "type": "backend",
      "label": "Draft rules",
      "sublabel": "Profile + INDEX + rules",
      "width": 148
    },
    {
      "id": "rule-gate",
      "lane": "review",
      "col": 4,
