    },
    {
      "id": "rules-hold",
      "lane": "hold",
      "col": 4,
      "type": "external",
      "label": "Revise rules",
      "sublabel": "Unapproved stays inactive",
      "width": 148
    }
  ],
  "mainPath": [
    "facts",
    "plan",
    "draft",
    "profile-gate",
    "candidate",
    "rule-gate",
    "active"
  ],
  "edges": [
    {
      "id": "facts-plan",
      "to": "plan",
      "role": "main",
      "from": "facts"
    },
    {
      "id": "plan-draft",
      "to": "draft",
      "role": "main",
      "from": "plan"
    },
    {
      "id": "draft-profile-gate",
      "to": "profile-gate",
      "role": "main",
      "from": "draft"
    },
    {
      "id": "profile-gate-candidate",
      "to": "candidate",
      "role": "main",
      "from": "profile-gate",
      "label": "Yes · core Level 1"
    },
    {
      "id": "candidate-rule-gate",
      "to": "rule-gate",
      "role": "main",
      "from": "candidate"
    },
    {
      "id": "rule-gate-active",
      "to": "active",
      "role": "main",
      "from": "rule-gate",
      "label": "Yes"
    },
    {
      "id": "profile-gate-facts-hold",
