      "role": "error",
      "from": "profile-gate",
      "label": "No",
      "variant": "security"
    },
    {
      "id": "rule-gate-rules-hold",
      "to": "rules-hold",
      "role": "error",
      "from": "rule-gate",
      "label": "No",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Evidence and intent",
      "items": [
        "Use approved for designs; observed for implementation facts.",
        "Candidates require review before they become active."
      ]
    },
    {
      "dot": "amber",
      "title": "Recheck after revision",
      "items": [
        "Return to the relevant review step after revising inputs.",
        "Delivery readiness and production consent are separate."
      ]
    }
  ]
}
