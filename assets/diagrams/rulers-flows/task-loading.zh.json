  "cards": [
    {
      "dot": "cyan",
      "title": "只读任务所需内容",
      "items": [
        "已知范围直接 load；未知范围先发现，再选择叶子。",
        "成功后复用正文；普通编码不自动同步模块或维修无关领域。"
      ]
    },
    {
      "dot": "amber",
      "title": "维护有判断与边界",
      "items": [
        "已有表达充分则不改；路由失效不重复正文，内容变化清除旧措辞。",
        "差异经适用审阅后采纳；事实变化走 reconcile，范围变化重新校验。"
      ]
    }
